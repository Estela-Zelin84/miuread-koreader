u76d6\u4e0e\u5199\u5165\u4e2d\u65ad\u98ce\u9669\u3002\n- \u540e\u53f0\u4efb\u52a1\u4f7f\u7528\u7a33\u5b9a\u4efb\u52a1\u7f16\u53f7\uff0c\u81ea\u52a8\u6062\u590d\u65f6\u590d\u7528\u65ad\u70b9\uff0c\u907f\u514d\u91cd\u590d\u5b89\u88c5\u3002\n\n\u60f3\u6cd5\u663e\u793a\u4e0e\u517c\u5bb9\u6027\n- \u4fee\u590d\u90e8\u5206 Kindle \u6216 KOReader \u5b57\u4f53\u6587\u4ef6\u4e0d\u5b8c\u6574\u65f6\uff0c\u60f3\u6cd5\u5f39\u7a97\u62a5\u9519\u4e14\u65e0\u6cd5\u67e5\u770b\u5185\u5bb9\u7684\u95ee\u9898\u3002\n- \u5bcc\u6587\u672c\u5f39\u7a97\u4e0d\u53ef\u7528\u65f6\u81ea\u52a8\u6539\u7528\u7b80\u5316\u6587\u5b57\u7a97\u53e3\uff0c\u540c\u4e00\u6b21\u8fd0\u884c\u4e2d\u4e0d\u518d\u53cd\u590d\u89e6\u53d1\u76f8\u540c\u5b57\u4f53\u5f02\u5e38\u3002\n- \u60f3\u6cd5\u7b80\u5316\u663e\u793a\u4f1a\u4fdd\u7559\u539f\u6587\u3001\u4f5c\u8005\u3001\u6b63\u6587\u548c\u70b9\u8d5e\u4fe1\u606f\uff0c\u5e76\u53bb\u9664\u91cd\u590d\u5185\u5bb9\u3002\n\n\u4f4e\u5185\u5b58\u6a21\u5f0f\n- \u4e0b\u8f7d\u9009\u9879\u65b0\u589e\u201c\u4f4e\u5185\u5b58\u6a21\u5f0f\u201d\uff0c\u9ed8\u8ba4\u5173\u95ed\uff0c\u9002\u5408\u4e0b\u8f7d\u5927\u4e66\u65f6\u5bb9\u6613\u95ea\u9000\u6216\u5361\u6b7b\u7684\u4f4e\u5185\u5b58\u8bbe\u5907\u3002\n- \u5f00\u542f\u540e\u51cf\u5c11 KOReader \u9875\u9762\u7f13\u5b58\u5e76\u63d0\u793a\u5b8c\u6574\u91cd\u542f\u540e\u751f\u6548\uff1b\u5173\u95ed\u65f6\u6062\u590d\u5f00\u542f\u524d\u7684\u7f13\u5b58\u8bbe\u7f6e\u3002\n- \u68c0\u6d4b\u5230\u8bbe\u7f6e\u5df2\u88ab\u5176\u4ed6\u914d\u7f6e\u4fee\u6539\u65f6\uff0c\u4e0d\u8986\u76d6\u5916\u90e8\u8bbe\u7f6e\u3002\n- \u53ef\u8bc6\u522b\u65e7\u7248\u672c\u6216\u5916\u90e8\u9057\u7559\u7684\u4f4e\u5185\u5b58\u503c\uff0c\u5e76\u63d0\u4f9b\u660e\u786e\u6062\u590d\u5165\u53e3\u3002\n\n\u754c\u9762\u3001\u65e5\u5fd7\u4e0e\u6e90\u7801\u6574\u7406\n- \u666e\u901a\u754c\u9762\u4e0d\u518d\u5c55\u793a\u5212\u7ebf\u6570\u91cf\u3001\u8bc4\u8bba\u6570\u91cf\u548c\u5185\u90e8\u5931\u8d25\u7ec6\u8282\uff0c\u53ea\u63d0\u793a\u7528\u6237\u9700\u8981\u91cd\u65b